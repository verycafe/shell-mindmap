{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "outDir": "dist", "rootDir": "src", "declaration": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
